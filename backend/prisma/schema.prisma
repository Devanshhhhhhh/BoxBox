// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// DRIVER
model Driver {
  id           Int     @id @default(autoincrement())
  driverNumber Int     @unique
  fullName     String
  teamName     String?
  countryCode  String?

  results Result[]
  laps Lap[]

  @@map("drivers")
}

// MEETING
model Meeting {
  id Int @id @default(autoincrement())
  meetingKey Int @unique
  meetingName String
  officialName String?

  countryCode String?
  countryName String
  location String

  circuitShortName String
  circuitImage String?

  dateStart DateTime
  dateEnd DateTime?

  year Int

  sessions Session[]

  @@map("meetings")
}

// SESSION
model Session {
  id Int @id @default(autoincrement())
  sessionKey Int @unique
  sessionName String
  sessionType String
  dateStart DateTime
  dateEnd DateTime?

  meetingId Int
  meeting Meeting @relation(fields: [meetingId], references: [id])

  results Result[]
  laps Lap[]

  @@map("sessions")
}

// RESULT
model Result {
  id Int @id @default(autoincrement())

  position Int?
  duration Json?
  gapToLeader Json?
  numberOfLaps Int?

  dnf Boolean
  dns Boolean
  dsq Boolean

  driverId Int
  sessionId Int

  driver Driver @relation(fields: [driverId], references: [id])
  session Session @relation(fields: [sessionId], references: [id])

  @@unique([driverId, sessionId])
  @@map("results")
}

// LAP
model Lap {
  id Int @id @default(autoincrement())

  dateStart DateTime?
  
  durationSector1 Float?
  durationSector2 Float?
  durationSector3 Float?

  isPitOutLap Boolean
  lapDuration Float?
  lapNumber Int

  sessionId Int
  driverId Int

  driver Driver @relation(fields: [driverId], references: [id])
  session Session @relation(fields: [sessionId], references: [id])

  @@unique([driverId, sessionId, lapNumber])
  @@map("laps")
}